# PocketGull Chem Soft — Organic Chemistry & Pharmacology Style
# Warm organic canvas with softened bond lines and high-clarity stoichiometry

# Figure & Canvas
figure.facecolor: "#fcfbf9"
figure.edgecolor: "#fcfbf9"
axes.facecolor: "#fcfbf9"
axes.edgecolor: "#57534e"
axes.linewidth: 1.1

# Text & Elements
font.family: "PocketGull"
text.color: "#0c0a09"
axes.labelcolor: "#0c0a09"
axes.titlesize: 13
axes.titleweight: "bold"
axes.titlelocation: "left"
axes.labelsize: 11
axes.labelweight: "medium"

# Math & Stoichiometry (Thickened sub/superscripts)
mathtext.fontset: "custom"
mathtext.rm: "PocketGull Chem"
mathtext.it: "PocketGull Chem:italic"
mathtext.bf: "PocketGull Chem:bold"

# Ticks
xtick.color: "#78716c"
ytick.color: "#78716c"
xtick.direction: "out"
ytick.direction: "out"
xtick.labelsize: 10
ytick.labelsize: 10

# Grid (Gentle baseline for titration & kinetic decay curves)
axes.grid: True
grid.color: "#f0eeea"
grid.linestyle: "-"
grid.linewidth: 0.8
grid.alpha: 0.9

# Molecular Bonds & Reaction Pathways
lines.linewidth: 2.4
lines.solid_capstyle: "round"
lines.solid_joinstyle: "round"

# Legend
legend.frameon: True
legend.facecolor: "#f5f4f0"
legend.edgecolor: "#e7e5e0"
legend.fontsize: 10
legend.framealpha: 0.95

# SVG Vector Export
svg.fonttype: "path"
