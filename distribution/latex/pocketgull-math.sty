\NeedsTeXFormat{LaTeX2E}[2020/01/01]
\ProvidesPackage{pocketgull-math}[2026/09/15 v3.1.0 PocketGull Humanist Clinical Math Font Package]

\RequirePackage{iftex}

\ifPDFTeX
  \PackageError{pocketgull-math}{%
    pocketgull-math requires an OpenType-capable engine (LuaLaTeX or XeLaTeX)%
  }{%
    Please compile this document using lualatex or xelatex instead of pdflatex.%
  }
\fi

\RequirePackage{kvoptions}
\SetupKeyvalOptions{
  family=PGM,
  prefix=PGM@
}

\DeclareBoolOption[false]{slashedzero}
\DeclareBoolOption[false]{curvedl}
\DeclareBoolOption[false]{serifedI}
\DeclareBoolOption[false]{tabular}
\DeclareStringOption[]{fontpath}
\ProcessKeyvalOptions*

\RequirePackage{unicode-math}

% Assemble OpenType RawFeatures based on package options
\def\PGM@features{}
\ifPGM@slashedzero
  \edef\PGM@features{\PGM@features+cv08;}
\fi
\ifPGM@curvedl
  \edef\PGM@features{\PGM@features+cv05;}
\fi
\ifPGM@serifedI
  \edef\PGM@features{\PGM@features+ss02;}
\fi
\ifPGM@tabular
  \edef\PGM@features{\PGM@features+tnum;}
\fi

% Primary OpenType Math Font Declaration
\ifx\PGM@fontpath\@empty
  \setmathfont{PocketGull-Math.ttf}[
    Scale=MatchLowercase,
    RawFeature={\PGM@features}
  ]
\else
  \setmathfont{PocketGull-Math.ttf}[
    Scale=MatchLowercase,
    Path=\PGM@fontpath,
    RawFeature={\PGM@features}
  ]
\fi

