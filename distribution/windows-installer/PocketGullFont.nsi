; PocketGull Font Superfamily v3.1.0 — Open-Source NSIS Installer (zlib/libpng license)
!include "MUI2.nsh"
!include "WinMessages.nsh"

Name "PocketGull Font"
OutFile "dist\PocketGull-Font-Setup-v3.1.0.exe"
Unicode True
SetCompressor /SOLID lzma
InstallDir "$PROGRAMFILES64\PocketGull Font"
RequestExecutionLevel admin
BrandingText "PocketGull Typeface v3.1.0 (SIL OFL-1.1)"

VIProductVersion "3.1.0.0"
VIAddVersionKey "ProductName" "PocketGull Font"
VIAddVersionKey "CompanyName" "The PocketGull Project Authors"
VIAddVersionKey "FileDescription" "PocketGull Clinical & Scientific Typeface Installer"
VIAddVersionKey "FileVersion" "3.1.0.0"
VIAddVersionKey "ProductVersion" "3.1.0"
VIAddVersionKey "LegalCopyright" "Copyright (c) 2026 The PocketGull Project Authors (OFL-1.1)"

!define MUI_ICON "assets\pocketgull.ico"
!define MUI_UNICON "assets\pocketgull.ico"
!define MUI_WELCOMEFINISHPAGE_BITMAP "assets\nsis-welcome.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "assets\nsis-welcome.bmp"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "assets\nsis-header.bmp"
!define MUI_HEADERIMAGE_RIGHT

!define MUI_WELCOMEPAGE_TITLE "PocketGull Typeface Superfamily (v3.1.0)"
!define MUI_WELCOMEPAGE_TEXT "This package installs 32 PocketGull TrueType fonts (Sans, Serif, Slab, Rounded, Fixed-Width Monospace, Mathematics, Sciences, Braille, and Sign Language) to your Windows Fonts folder.$\r$\n$\r$\nDesigned by Phil Gear (The PocketGull Project Authors) with explicit character disambiguation (0/O, 1/l/I, Z/2, b/d, p/q).$\r$\n$\r$\nLicense: SIL Open Font License 1.1 (OFL-1.1).$\r$\n$\r$\nClick Install to register the fonts on your system."
!define MUI_PAGE_CUSTOMFUNCTION_SHOW WelcomeChangeNextToInstall
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Function WelcomeChangeNextToInstall
  GetDlgItem $0 $HWNDPARENT 1
  SendMessage $0 ${WM_SETTEXT} 0 "STR:&Install"
FunctionEnd

Section "Install" SecMain
  SetRegView 64
  SetOutPath "$INSTDIR"
  SetOverwrite try
  File "assets\pocketgull.ico"
  File "..\..\OFL.txt"
  File "..\..\README.md"

  SetOutPath "$FONTS"
  File "stage_ttf\PocketGull-Algo.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull-Algo (TrueType)" "PocketGull-Algo.ttf"
  File "stage_ttf\PocketGull-ASL.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Sign (TrueType)" "PocketGull-ASL.ttf"
  File "stage_ttf\PocketGull-Black.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Black (TrueType)" "PocketGull-Black.ttf"
  File "stage_ttf\PocketGull-Bold.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Bold (TrueType)" "PocketGull-Bold.ttf"
  File "stage_ttf\PocketGull-BoldItalic.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Bold Italic (TrueType)" "PocketGull-BoldItalic.ttf"
  File "stage_ttf\PocketGull-Chem.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Chem (TrueType)" "PocketGull-Chem.ttf"
  File "stage_ttf\PocketGull-CondensedBold.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Condensed Bold (TrueType)" "PocketGull-CondensedBold.ttf"
  File "stage_ttf\PocketGull-Emoji.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull-Emoji (TrueType)" "PocketGull-Emoji.ttf"
  File "stage_ttf\PocketGull-Fineliner.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Regular (TrueType)" "PocketGull-Fineliner.ttf"
  File "stage_ttf\PocketGull-Genome.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Genome (TrueType)" "PocketGull-Genome.ttf"
  File "stage_ttf\PocketGull-Halftone.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Halftone (TrueType)" "PocketGull-Halftone.ttf"
  File "stage_ttf\PocketGull-Inline.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Inline (TrueType)" "PocketGull-Inline.ttf"
  File "stage_ttf\PocketGull-Italic.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Italic (TrueType)" "PocketGull-Italic.ttf"
  File "stage_ttf\PocketGull-Lab.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Lab (TrueType)" "PocketGull-Lab.ttf"
  File "stage_ttf\PocketGull-Learn.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Learn (TrueType)" "PocketGull-Learn.ttf"
  File "stage_ttf\PocketGull-MarkerRaw.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Marker Raw (TrueType)" "PocketGull-MarkerRaw.ttf"
  File "stage_ttf\PocketGull-Math.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Math (TrueType)" "PocketGull-Math.ttf"
  File "stage_ttf\PocketGull-Micro.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Micro (TrueType)" "PocketGull-Micro.ttf"
  File "stage_ttf\PocketGull-Music.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Music (TrueType)" "PocketGull-Music.ttf"
  File "stage_ttf\PocketGull-Numerics.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Variable (TrueType)" "PocketGull-Numerics.ttf"
  File "stage_ttf\PocketGull-Outline.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Outline (TrueType)" "PocketGull-Outline.ttf"
  File "stage_ttf\PocketGull-Press.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Press (TrueType)" "PocketGull-Press.ttf"
  File "stage_ttf\PocketGull-Serif-Bold.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Serif Bold (TrueType)" "PocketGull-Serif-Bold.ttf"
  File "stage_ttf\PocketGull-Serif-Regular.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Serif Regular (TrueType)" "PocketGull-Serif-Regular.ttf"
  File "stage_ttf\PocketGull-Slab-Bold.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Slab Bold (TrueType)" "PocketGull-Slab-Bold.ttf"
  File "stage_ttf\PocketGull-Slab-Regular.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Slab Regular (TrueType)" "PocketGull-Slab-Regular.ttf"
  File "stage_ttf\PocketGull-Soft-Bold.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Soft Bold (TrueType)" "PocketGull-Soft-Bold.ttf"
  File "stage_ttf\PocketGull-Soft-Regular.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Soft Regular (TrueType)" "PocketGull-Soft-Regular.ttf"
  File "stage_ttf\PocketGull-VF.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull VF (TrueType)" "PocketGull-VF.ttf"
  File "stage_ttf\PocketGullMono-Bold.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Mono Bold (TrueType)" "PocketGullMono-Bold.ttf"
  File "stage_ttf\PocketGullMono-Italic.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Mono Italic (TrueType)" "PocketGullMono-Italic.ttf"
  File "stage_ttf\PocketGullMono-Regular.ttf"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Mono Regular (TrueType)" "PocketGullMono-Regular.ttf"

  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "DisplayName" "PocketGull Font"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "DisplayVersion" "3.1.0"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "Publisher" "The PocketGull Project Authors"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "URLInfoAbout" "https://font.pocketgull.app"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "DisplayIcon" "$INSTDIR\pocketgull.ico"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "UninstallString" "$\"$INSTDIR\Uninstall.exe$\""
  WriteRegStr HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "QuietUninstallString" "$\"$INSTDIR\Uninstall.exe$\" /S"
  WriteRegDWORD HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "NoModify" 1
  WriteRegDWORD HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font" "NoRepair" 1
  SetErrorLevel 0
SectionEnd

Section "Uninstall"
  SetRegView 64
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull-Algo (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Algo.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Sign (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-ASL.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Black (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Black.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Bold (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Bold.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Bold Italic (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-BoldItalic.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Chem (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Chem.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Condensed Bold (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-CondensedBold.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull-Emoji (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Emoji.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Regular (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Fineliner.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Genome (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Genome.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Halftone (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Halftone.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Inline (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Inline.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Italic (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Italic.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Lab (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Lab.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Learn (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Learn.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Marker Raw (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-MarkerRaw.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Math (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Math.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Micro (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Micro.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Music (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Music.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Variable (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Numerics.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Outline (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Outline.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Press (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Press.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Serif Bold (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Serif-Bold.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Serif Regular (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Serif-Regular.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Slab Bold (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Slab-Bold.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Slab Regular (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Slab-Regular.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Soft Bold (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Soft-Bold.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull Soft Regular (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-Soft-Regular.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "PocketGull VF (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGull-VF.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Mono Bold (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGullMono-Bold.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Mono Italic (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGullMono-Italic.ttf"
  DeleteRegValue HKLM "SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" "Pocket Gull Mono Regular (TrueType)"
  Delete /REBOOTOK "$FONTS\PocketGullMono-Regular.ttf"
  Delete "$INSTDIR\pocketgull.ico"
  Delete "$INSTDIR\OFL.txt"
  Delete "$INSTDIR\README.md"
  Delete "$INSTDIR\Uninstall.exe"
  RMDir "$INSTDIR"
  DeleteRegKey HKLM "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PocketGull.Font"
  SetErrorLevel 0
SectionEnd
