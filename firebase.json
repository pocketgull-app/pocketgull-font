{
  "hosting": {
    "site": "font-pocketgull-app",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "apache/**",
      "api/**",
      "apps/**",
      "article/**",
      "dist/**",
      "distribution/**",
      "experiments/**",
      "flutter/**",
      "local/**",
      "ofl/**",
      "private/**",
      "public/**",
      "scratch/**",
      "scripts/**",
      "sources/**",
      "test/**",
      "test-results/**",
      "tests/**",
      "tool/**",
      "Dockerfile*",
      "package*.json",
      "requirements*.lock",
      "requirements*.txt",
      "*.py",
      "*.md",
      "*.toml",
      "*.yml",
      "*.yaml"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "same-origin"
          },
          {
            "key": "Cross-Origin-Embedder-Policy",
            "value": "credentialless"
          },
          {
            "key": "Origin-Agent-Cluster",
            "value": "?1"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=(), payment=(), tools=(self), usb=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' 'sha256-Sr3Cc6oo3+usSIYAVOyRuNUErWvaqH8HGe2RMSdrLfU=' 'sha256-v3xyCo3kv7u0LBFvL4HnS7yb79Hzkovd5FLPJU6+1O8=' 'sha256-eM8/uLPn+slwOk3wpF/ntZOBxpmyaCiOj6ODCpPUL0Y=' 'sha256-dE9xBZMAvfxGiXYmB7WLzljtbk5ziwWqb6Y5L+xzs38=' 'sha256-cAn7ZXqx6kxLzTtHmDzcZx1KUbwEp9EH+4BQtDxjPHo=' 'sha256-lV1atztDwmcspgXB5copApUX8/JoPlbmF+jbuvUcpBE=' 'sha256-tUd5FWxl/PKOqqmVJ53o0CGss/mt+CIJ9yOJvkT0isY=' 'sha256-bTzy8CmoxVDcNfDlB2SyiBCJE3iceYDe0G8XDlGh88M=' 'sha256-+IyXuhcKsjSfsD+1sfNAIev3bXbFuqClx5RtQFakNcI=' 'sha256-OymJ6Lvug7YiqMCcp48h6p1GOwLw8SSTGqsf2UODq/c=' 'sha256-ujlahzrRYpzNhJuplcO12OtvEqJ4nEE8+OUPaXAhlNg=' 'sha256-xnPyAn1Kwu1t3wlRXfRuK/iQmiT0pbN6zru7iRd7S74=' 'sha256-J1H6m1DzDQdaeQ5U+L513vRdKdQxoffvViWfgZGbfws=' 'sha256-Xy85nmvXTcYAVPqqN2eDSYJ9n98uBSjQ7OfZI4t2Dgk=' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://generativelanguage.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; worker-src 'self' blob:; object-src 'none'; frame-src 'self' https://www.paypal.com https://*.paypal.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
          }
        ]
      },
      {
        "source": "fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "cross-origin"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|ttf|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "cross-origin"
          }
        ]
      },
      {
        "source": "*.@(woff2|ttf|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "cross-origin"
          }
        ]
      },
      {
        "source": "documentation/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, immutable"
          }
        ]
      },
      {
        "source": "fonts.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "cross-origin"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      }
    ]
  }
}
