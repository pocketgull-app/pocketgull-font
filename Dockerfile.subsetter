# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# PocketGull Dynamic SMoE Subsetter Service
# Cloud Run Serverless Micro-Container (Scale-to-Zero, 0 Cost Ingress/Idle)
# ------------------------------------------------------------------------------

# Stage 1: Fast Pure-Dart AOT Compilation
FROM dart:3-sdk@sha256:7efb22ee3003e3aaa7af34840bfacb2fc1b06e1ac1295237dfcca1552816588e AS build

WORKDIR /app
COPY pubspec.* ./
RUN dart pub get

COPY . .
RUN dart compile exe tool/pocketgull_foundry.dart -o /app/pocketgull_foundry

# Stage 2: Distroless Minimal Security Image (<40MB)
FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f

WORKDIR /app

# Copy compiled AOT binary
COPY --from=build /app/pocketgull_foundry /app/pocketgull_foundry

# Copy fonts directory for serverless font loading
COPY --from=build /app/fonts /app/fonts

ENV PORT=8080
EXPOSE 8080

# Run as nonroot user (UID 65532) with read-only rootfs
USER nonroot:nonroot

ENTRYPOINT ["/app/pocketgull_foundry", "subset-service"]
