{
  "name": "@pocketgull/font",
  "version": "3.1.0",
  "type": "module",
  "description": "Optotypically calibrated clinical and ophthalmological vector font superfamily bridging tactile humanist warmth with zero-error clinical precision.",
  "main": "fonts.css",
  "style": "fonts.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/pocketgull-app/pocketgull-font.git"
  },
  "keywords": [
    "font",
    "typeface",
    "clinical",
    "ophthalmology",
    "braille",
    "ismp",
    "sloan-optotypes",
    "wcag-aaa",
    "woff2",
    "truetype"
  ],
  "author": "Phil Gear <philgear@gmail.com> (https://orcid.org/0009-0008-1372-5381)",
  "contributors": [
    "The PocketGull Project Authors",
    "Emma"
  ],
  "license": "OFL-1.1",
  "bugs": {
    "url": "https://github.com/pocketgull-app/pocketgull-font/issues"
  },
  "homepage": "https://font.pocketgull.app",
  "scripts": {
    "build": "dart run tool/pocketgull_foundry.dart build",
    "test": "dart run tool/pocketgull_foundry.dart audit && node --test test/*.test.mjs && node scripts/run-font-validator.mjs",
    "audit": "dart run tool/pocketgull_foundry.dart audit",
    "validate": "node scripts/run-font-validator.mjs",
    "checksums": "node scripts/generate_checksums.mjs",
    "serve": "dart run tool/pocketgull_foundry.dart serve 8770",
    "test:unit": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/specimen_interactions_playwright.test.mjs",
    "test:lighthouse": "node --test test/lighthouse_and_wcag_audit.test.mjs"
  },
  "files": [
    "fonts/ttf/*.ttf",
    "fonts/woff2/*.woff2",
    "fonts.css",
    "pocketgull.css",
    "OFL.txt",
    "LICENSE.txt",
    "CITATION.cff"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0"
  }
}
