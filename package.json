{
  "name": "@pocketgull/font",
  "version": "4.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Optotypically calibrated clinical and ophthalmological vector font superfamily bridging tactile humanist warmth with zero-error clinical precision.",
  "main": "./css/npm/index.css",
  "style": "./css/npm/index.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./css/npm/index.css",
    "./core.css": "./css/npm/core.css",
    "./sans.css": "./css/npm/sans.css",
    "./slab.css": "./css/npm/slab.css",
    "./mono.css": "./css/npm/mono.css",
    "./serif.css": "./css/npm/serif.css",
    "./pocketgull.css": "./pocketgull.css",
    "./fonts/woff2/*": "./fonts/woff2/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pocketgull-app/pocketgull-font.git"
  },
  "keywords": [
    "font",
    "typeface",
    "clinical",
    "ophthalmology",
    "braille",
    "ismp",
    "sloan-optotypes",
    "wcag-aaa",
    "woff2",
    "truetype"
  ],
  "author": "Phil Gear <philgear@gmail.com> (https://orcid.org/0009-0008-1372-5381)",
  "contributors": [
    "The PocketGull Project Authors"
  ],
  "license": "OFL-1.1",
  "bugs": {
    "url": "https://github.com/pocketgull-app/pocketgull-font/issues"
  },
  "homepage": "https://font.pocketgull.app",
  "scripts": {
    "build": "dart run tool/pocketgull_foundry.dart build",
    "test": "dart run tool/pocketgull_foundry.dart audit && node --test test/*.test.mjs && node scripts/run-font-validator.mjs",
    "audit": "dart run tool/pocketgull_foundry.dart audit",
    "validate": "node scripts/run-font-validator.mjs",
    "checksums": "node scripts/generate_checksums.mjs",
    "serve": "dart run tool/pocketgull_foundry.dart serve 8770",
    "test:unit": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/specimen_interactions_playwright.test.mjs",
    "test:lighthouse": "node --test test/lighthouse_and_wcag_audit.test.mjs",
    "benchmark": "node --test test/system_provisions_benchmark.test.mjs"
  },
  "files": [
    "css/npm/*.css",
    "pocketgull.css",
    "fonts/woff2/PocketGull-Regular-Core.woff2",
    "fonts/woff2/PocketGull-Bold-Core.woff2",
    "fonts/woff2/PocketGull-Micro-Core.woff2",
    "fonts/woff2/PocketGull-Regular.woff2",
    "fonts/woff2/PocketGull-Bold.woff2",
    "fonts/woff2/PocketGull-Italic.woff2",
    "fonts/woff2/PocketGull-BoldItalic.woff2",
    "fonts/woff2/PocketGull-Slab-Regular.woff2",
    "fonts/woff2/PocketGull-Slab-Bold.woff2",
    "fonts/woff2/PocketGullMono-Regular.woff2",
    "fonts/woff2/PocketGullMono-Bold.woff2",
    "fonts/woff2/PocketGullMono-Italic.woff2",
    "fonts/woff2/PocketGull-Serif-Regular.woff2",
    "fonts/woff2/PocketGull-Serif-Bold.woff2",
    "OFL.txt",
    "LICENSE-APACHE-2.0.txt",
    "CITATION.cff"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0"
  }
}
